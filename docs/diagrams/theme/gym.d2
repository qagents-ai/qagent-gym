style.fill: "#F5FAF8"

classes: {
  step: {
    style: {
      fill: "#FFFFFF"
      stroke: "#66817A"
      stroke-width: 1
      border-radius: 12
      font-color: "#18273B"
      font-size: 18
    }
  }
  core: {
    style: {
      fill: "#075A57"
      stroke: "#075A57"
      border-radius: 12
      font-color: "#FFFFFF"
      font-size: 18
      bold: true
    }
  }
  external: {
    style: {
      fill: "#FFF3E6"
      stroke: "#98592F"
      stroke-width: 1
      border-radius: 12
      font-color: "#51341D"
      font-size: 18
    }
  }
  store: {
    shape: cylinder
    style: {
      fill: "#E6F2F8"
      stroke: "#41657E"
      stroke-width: 1
      font-color: "#18273B"
      font-size: 18
    }
  }
  flow: {
    style: {
      stroke: "#46635E"
      stroke-width: 2
      border-radius: 10
      font-color: "#18273B"
      font-size: 15
    }
  }
}
