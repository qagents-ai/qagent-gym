flowchart TB
  accTitle: QAgents execution and QAgent Gym architecture
  accDescr: The host supplies identity, configuration and approval decisions. QAgents runs the model and typed tools with an execution journal. Gym supplies scoped context and separately evaluates generations and stores learning provenance.
  host["HOST APPLICATION\nIdentity · configuration · approvals"]
  agent["QAGENTS AGENT\nInstructions · tools · limits"]
  provider["MODEL ENDPOINT\nExplicitly configured provider"]
  policy["PERMISSIONS\nAllow · ask · deny"]
  tools["APPLICATION TOOLS\nValidated, authorized operations"]
  journal[("SESSION JOURNAL\nMessages · approvals · tool results")]
  gym["QAGENT GYM\nScoped context · evaluation\nTraining reflection + curation"]
  gymstore[("GYM STORE\nEpisodes · lessons · memory\nProvenance by namespace")]
  host --> agent
  agent <-->|requests / responses| provider
  agent --> policy --> tools
  agent <-->|record / resume| journal
  tools -->|record result| journal
  agent <-->|context in / generation out| gym
  gym <-->|persist / retrieve| gymstore
  classDef host fill:#173b3a,color:#ffffff,stroke:#173b3a;
  classDef core fill:#e7f3f1,stroke:#307b75;
  classDef store fill:#eef2f7,stroke:#617585;
  class host host;
  class agent,gym core;
  class journal,gymstore store;
