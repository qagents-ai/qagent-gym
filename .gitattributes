# Evidence manifests hash exact bytes; checkout must preserve those bytes on every OS.
/benchmarks/recovery/results/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/assets/benchmarks/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Matplotlib includes trailing spaces in generated path data; keep the signed artifact intact.
/benchmarks/recovery/results/**/*.svg -whitespace
/assets/benchmarks/**/*.svg -whitespace
